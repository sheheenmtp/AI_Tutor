# Database
DATABASE_URL=

# Code execution (Judge0)
JUDGE0_URL=
JUDGE0_BASH_LANGUAGE_ID=

# Local LLM (Ollama)
OLLAMA_URL=
OLLAMA_MODEL=

# Optional administrative DB URL for migrations
DATABASE_ADMIN_URL=

# Other environment variables used across services
# e.g., SECRET_KEY, REDIS_URL, etc. Add as needed.
# Copy this file to .env if you want to keep a root-level environment file.
# The app reads the backend and frontend environment files directly.
DATABASE_URL=postgresql+psycopg2://<username>:<password>@<host>:5432/<database_name>
JUDGE0_URL=http://localhost:2358
OLLAMA_URL=http://localhost:11434
VITE_API_URL=http://localhost:8000
